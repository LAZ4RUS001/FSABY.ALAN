        if ok and typeof(mods) == "table" then
            for _, m in ipairs(mods) do
                if m.Name == "Net" then
                    local okReq, res = pcall(require, m)
                    if okReq and res and (res.State or res.invoke or res.fire) then
                        Net = res
                        if res.State then break end
                    end
                end
            end
        end
    end
end)
