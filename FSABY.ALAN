-- ปุ่มลอยหน้าจอแบบลากได้อิสระ (Floating Draggable Toggle Button) รองรับ Mobile และ PC
local function createFloatingToggleButton()
    pcall(function()
        local safeParent = getSafeGuiParent()
        if not safeParent then return end

        local toggleGui = Instance.new("ScreenGui")
        toggleGui.Name = "SpinachMobileToggle"
        toggleGui.ResetOnSpawn = false
        toggleGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

        local btn = Instance.new("TextButton")
        btn.Name = "ToggleBtn"
        btn.Size = UDim2.fromOffset(46, 46)
        btn.Position = UDim2.new(0, 18, 0.45, -23)
        btn.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
        btn.BorderSizePixel = 0
        btn.Text = "🐟"
        btn.TextSize = 22
        btn.AutoButtonColor = true
        btn.Parent = toggleGui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = btn

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(56, 130, 246)
        stroke.Thickness = 1.8
        stroke.Parent = btn

        local dragging = false
        local dragInput, dragStart, startPos

        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = btn.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        btn.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                btn.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end)

        btn.Activated:Connect(function()
            pcall(function()
                if Window.Minimize then
                    Window:Minimize()
                elseif Window.Root then
                    Window.Root.Visible = not Window.Root.Visible
                end
            end)
        end)

        toggleGui.Parent = safeParent
        getgenv()._SpinachMobileGui = toggleGui
    end)
end
createFloatingToggleButton()

