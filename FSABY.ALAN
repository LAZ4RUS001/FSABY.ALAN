    local displayThreshold = ConfigState.SellThresholdText or formatCurrencyNumber(ConfigState.SellThreshold)
    StatusParagraph:SetDesc(string.format("%s\nCatches: %d | Sold: %d | Filter: <= $%s/s", 
        text or "Running", 
        ConfigState.TotalCatches, 
        ConfigState.TotalSold, 
        tostring(displayThreshold)))
end

