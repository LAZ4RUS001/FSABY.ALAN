-- ดักจับสัญญาณ 2x DoubleRep (boolean) เพื่อกดเคลมทันที 0ms
getgenv()._DoubleRepConn = LocalPlayer:GetAttributeChangedSignal("DoubleRep"):Connect(function()
    if ConfigState.AutoHitDoubleRep and LocalPlayer:GetAttribute("DoubleRep") == true then
        pcall(function()
            Net.fire("DoubleRep")
            ConfigState.TotalDoubleHits = ConfigState.TotalDoubleHits + 1
        end)
    end
end)

-- ฟังก์ชันอัปเดตข้อมูลบนหน้า UI Training
local function updateTrainingDisplays()
    pcall(function()
        local level = LocalPlayer:GetAttribute("Level") or 1
        local xp = LocalPlayer:GetAttribute("XP") or 0
        local xpNeed = LocalPlayer:GetAttribute("XPNeed") or 1
        local barTier = LocalPlayer:GetAttribute("BarTier") or 0
        local barInfo = (Config.BarTiers and Config.BarTiers[barTier]) or { Name = "Steel Bar", XP = 4 }
        local power = LocalPlayer:GetAttribute("Power") or 0
        local biome = Config.ReachBiome and Config.ReachBiome(power)
        local biomeName = biome and biome.Name or "Pond"
        local bait = tostring(LocalPlayer:GetAttribute("Bait") or "Worm")

        local statusSymbol = "• idle"
        if ConfigState.CycleState == "Training" then
            statusSymbol = string.format("• training (%ds)", math.floor(ConfigState.CycleTimeLeft))
        elseif ConfigState.CycleState == "Throwing" then
            statusSymbol = string.format("• throwing (%ds)", math.floor(ConfigState.CycleTimeLeft))
        end

        TrainingStatusParagraph:SetDesc(string.format("%s\nCycle %s", statusSymbol, ConfigState.CycleState))

        TrainingInfoParagraph:SetTitle(string.format("Level %d               %s / %s", level, tostring(xp), tostring(xpNeed)))
        TrainingInfoParagraph:SetDesc(string.format("%s, %d XP a rep\nPower: %d studs (%s)\n%d x2 bonuses",
            tostring(barInfo.Name or "Bar"),
            tonumber(barInfo.XP or 1),
            tonumber(power),
            biomeName,
            ConfigState.TotalDoubleHits
        ))

        ThrowingInfoParagraph:SetDesc(string.format("Reach %d studs, %s\nFood: %s\nLast: %s\nCycle %s",
            tonumber(power),
            biomeName,
            bait,
            ConfigState.LastCatchText,
            ConfigState.CycleState
        ))
    end)
end

AutoTrainToggle:OnChanged(function()
    ConfigState.AutoTrain = Options.AutoTrain.Value
    if not ConfigState.AutoTrain then
        stopTraining()
        stopCasting()
        ConfigState.CycleState = "Idle"
        ConfigState.CycleTimeLeft = 0
        updateTrainingDisplays()
    else
        stopCasting()
        ConfigState.CycleState = "Training"
        ConfigState.CycleTimeLeft = tonumber(ConfigState.TrainForSeconds) or 60
        task.spawn(startTraining)
        updateTrainingDisplays()
    end
    saveAccountConfig()
end)

-- ==========================================
-- BACKGROUND WORKER: CYCLE, ANTI-AFK, REWARDS
-- ==========================================
task.spawn(function()
    local lastPeriodicEquip = 0
    local lastRewardCheck = 0
    local lastShopCheck = 0
    local lastAfkPulse = 0
    local lastCycleTick = os.clock()
    local lastDisplayUpdate = 0

    while getgenv()._AutoFishToken == currentToken do
        task.wait(0.12)
        local now = os.clock()

        -- 1. ลูปคุม Cycle Training & Throwing
        if ConfigState.AutoTrain then
            if now - lastCycleTick >= 1 then
                lastCycleTick = now
                ConfigState.CycleTimeLeft = math.max(0, ConfigState.CycleTimeLeft - 1)

                pcall(function()
                    if ConfigState.CycleState == "Training" then
                        -- เช็คและกด DoubleRep
                        if ConfigState.AutoHitDoubleRep and LocalPlayer:GetAttribute("DoubleRep") == true then
                            pcall(function()
                                Net.fire("DoubleRep")
                                ConfigState.TotalDoubleHits = ConfigState.TotalDoubleHits + 1
                            end)
                        end

                        -- เช็คอัปเกรดบาร์
                        if ConfigState.AutoBuyBar or ConfigState.AutoUpgradeBar then
                            tryBuyBar()
                        end

                        -- ตรวจสอบว่ายังเกาะบาร์อยู่หรือไม่
                        local char = LocalPlayer.Character
                        if not (char and char:GetAttribute("Training")) then
                            task.spawn(startTraining)
                        end

                        -- หมดเวลาฝึก ย้ายไปเหวี่ยงเบ็ด
                        if ConfigState.CycleTimeLeft <= 0 then
                            stopTraining()
                            task.wait(0.3)
                            teleportToLedge()
                            local pg = LocalPlayer:FindFirstChild("PlayerGui")
                            if pg and pg:FindFirstChild("CastGui") then
                                pg.CastGui.Enabled = true
                            end
                            ConfigState.CycleState = "Throwing"
                            ConfigState.CycleTimeLeft = tonumber(ConfigState.ThrowForSeconds) or 60
                            ConfigState.AutoFish = true
                        end

                    elseif ConfigState.CycleState == "Throwing" then
                        ensurePosition()

                        -- เมื่อหมดเวลาเหวี่ยงเบ็ด: ปิดหน้าต่างการเหวี่ยงเบ็ดทันที และย้ายไปดึงข้อที่บาร์
                        if ConfigState.CycleTimeLeft <= 0 then
                            ConfigState.AutoFish = false
                            stopCasting()
                            task.wait(0.3)
                            task.spawn(startTraining)
                            ConfigState.CycleState = "Training"
                            ConfigState.CycleTimeLeft = tonumber(ConfigState.TrainForSeconds) or 60
                        end
                    end
                end)
            end
        end

        -- อัปเดต UI Training ทุก 1 วินาที
        if now - lastDisplayUpdate >= 1 then
            lastDisplayUpdate = now
            updateTrainingDisplays()
        end

        -- 2. Anti-AFK Background Pulse ทุก 120 วินาที เพื่อรีเซ็ต Idle Timer ฝั่ง Client
        if ConfigState.AntiAfk and (now - lastAfkPulse >= 120) then
            lastAfkPulse = now
            triggerAntiAfk()
        end

        -- 3. ตรวจจับและหยุด Slot Machine ของ Secret Cast อัตโนมัติ
        if ConfigState.AutoSecretCast then
            pcall(function()
                local pg = LocalPlayer:FindFirstChild("PlayerGui")
                local castGui = pg and pg:FindFirstChild("CastGui")
                local slots = castGui and castGui:FindFirstChild("Slots")
                local machine = slots and slots:FindFirstChild("Machine")
                local tap = machine and machine:FindFirstChild("Tap")

                if slots and slots.Visible and tap and tap.Visible then
                    safeClickGui(tap)
                    updateStatus("Secret Cast: Reel Stopped!")
                end
            end)
        end

        -- 4. เคลียร์ Popup แจ้งเตือน Pen Full เข้าคลังสัตว์อัตโนมัติ
        if ConfigState.AutoStorePenFull then
            pcall(function()
                local pg = LocalPlayer:FindFirstChild("PlayerGui")
                local penFull = pg and pg:FindFirstChild("PenFull")
                if penFull and penFull.Enabled then
                    for _, container in ipairs({ LocalPlayer.Character, LocalPlayer:FindFirstChildOfClass("Backpack") }) do
                        if container then
                            for _, tool in ipairs(container:GetChildren()) do
                                if tool:IsA("Tool") and tool:GetAttribute("BeastId") then
                                    Net.fire("StoreBeast", tool:GetAttribute("BeastId"))
                                end
                            end
                        end
                    end
                    penFull.Enabled = false
                end
            end)
        end

        -- 5. ตรวจเช็คและเคลม Playtime Gifts / Daily Rewards อัตโนมัติ (ทุก 15 วินาที)
        if now - lastRewardCheck >= 15 then
            lastRewardCheck = now
            if ConfigState.AutoClaimRewards then
                task.spawn(claimAllRewards)
            end
        end

        -- 6. ตรวจเช็คและใส่สัตว์/ไข่ที่ดีที่สุดตามระยะเวลา (ทุก 10 วินาที)
        if now - lastPeriodicEquip >= 10 then
            lastPeriodicEquip = now
            if ConfigState.AutoEquipBestBeasts then
                equipBestBeasts()
            end
            if ConfigState.AutoEquipBestEggs then
                equipBestEggs()
            end
        end

        -- 7. ตรวจเช็คและขายสัตว์ในคลังที่มูลค่าต่ำกว่าเกณฑ์อัตโนมัติ (ทุก 15 วินาที)
        if ConfigState.AutoSellByRate and (ConfigState.CycleState ~= "Training") and (now - lastPeriodicEquip >= 5) then
            pcall(function()
                local state = Net.State
                if state and state.Beasts then
                    local needClean = false
                    for _, b in pairs(state.Beasts) do
                        if b.S == "store" and not b.L and (b.V or 0) <= ConfigState.SellThreshold then
                            needClean = true
                            break
                        end
                    end
                    if needClean then
                        local count = cleanStorageByValue(ConfigState.SellThreshold)
                        if count > 0 then
                            ConfigState.TotalSold = ConfigState.TotalSold + count
                            updateStatus("Cleaned " .. count .. " beasts from storage")
                            if ConfigState.AutoBuyRods then
                                task.spawn(tryBuyRod)
                            end
                            if ConfigState.AutoBuyBar then
                                task.spawn(tryBuyBar)
                            end
                        end
                    end
                end
            end)
        end

        -- 8. ตรวจเช็คและซื้อเบ็ด (Auto Buy Rods) และ บาร์ (Auto Buy Bar) อัตโนมัติ (ทุก 5 วินาที)
        if now - lastShopCheck >= 5 then
            lastShopCheck = now
            if ConfigState.AutoBuyRods then
                task.spawn(tryBuyRod)
            end
            if ConfigState.AutoBuyBar then
                task.spawn(tryBuyBar)
            end
        end
    end
end)

-- ==========================================
-- FISHING LOOP
-- ==========================================
task.spawn(function()
    local sessionCatchCount = 0

    while getgenv()._AutoFishToken == currentToken do
        if ConfigState.AutoFish and (ConfigState.CycleState ~= "Training") then
            ensurePosition()

            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            local slots = pg and pg:FindFirstChild("CastGui") and pg.CastGui:FindFirstChild("Slots")
            local inSecretSlots = slots and slots.Visible

            if not inSecretSlots then
                local castPower = LocalPlayer:GetAttribute("CastPower") or 1
                local beginOk = Net.invoke("CastBegin")

                if beginOk then
                    local castResult = Net.invoke("Cast", 1, castPower)

                    if castResult and castResult.Id then
                        local claimOk = Net.invoke("ClaimCatch", castResult.Id)
                        if claimOk then
                            ConfigState.TotalCatches = ConfigState.TotalCatches + 1
                            sessionCatchCount = sessionCatchCount + 1

                            local beastValue = castResult.Value or 0
                            local beastName = tostring(castResult.Name or "Beast")
                            local rarity = tostring(castResult.Rarity or "")

                            ConfigState.LastCatchText = string.format("%s [%s] ($%s/s)", beastName, rarity, formatCurrencyNumber(beastValue))

                            if ConfigState.AutoSellByRate and beastValue <= ConfigState.SellThreshold then
                                task.wait(0.08)
                                local soldOk = Net.invoke("Sell", "Landed")
                                if not soldOk then
                                    -- หากขายแบบ Landed ไม่ผ่าน (เช่น เข้า storage ทันที) ให้ขายที่ Stall ทันที
                                    pcall(function()
                                        local char = LocalPlayer.Character
                                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                                        if hrp then
                                            local prevCF = hrp.CFrame
                                            hrp.CFrame = CFrame.new(-140, 89.5, -26.7)
                                            task.wait(0.18)
                                            local ok = Net.invoke("SellBeast", castResult.Id)
                                            if ok then
                                                soldOk = true
                                            end
                                            hrp.CFrame = prevCF
                                        end
                                    end)
                                end

                                if soldOk then
                                    ConfigState.TotalSold = ConfigState.TotalSold + 1
                                    updateStatus(string.format("Sold: %s ($%s/s)", beastName, formatCurrencyNumber(beastValue)))
                                    if ConfigState.AutoBuyRods then
                                        task.spawn(tryBuyRod)
                                    end
                                    if ConfigState.AutoBuyBar then
                                        task.spawn(tryBuyBar)
                                    end
                                else
                                    updateStatus(string.format("Kept: %s ($%s/s)", beastName, formatCurrencyNumber(beastValue)))
                                end
                            else
                                updateStatus(string.format("KEPT: %s [%s] ($%s/s)", beastName, rarity, formatCurrencyNumber(beastValue)))
                                if ConfigState.AutoEquipBestBeasts then
                                    task.spawn(equipBestBeasts)
                                end
                            end
                        end
                    else
                        Net.fire("CastEnd")
                    end
                else
                    task.wait(0.4)
                end

                if ConfigState.AutoSellByRate and sessionCatchCount >= 5 then
                    sessionCatchCount = 0
                    local count = cleanStorageByValue(ConfigState.SellThreshold)
                    if count > 0 then
                        ConfigState.TotalSold = ConfigState.TotalSold + count
                        updateStatus("Cleaned " .. count .. " beasts from storage")
                        if ConfigState.AutoBuyRods then
                            task.spawn(tryBuyRod)
                        end
                        if ConfigState.AutoBuyBar then
                            task.spawn(tryBuyBar)
                        end
                    end
                end
            else
                task.wait(0.5)
            end
        end

        task.wait(0.2)
    end
end)

pcall(function()
    if InterfaceManager and typeof(InterfaceManager.SetLibrary) == "function" then
        InterfaceManager:SetLibrary(Fluent)
        InterfaceManager:SetFolder("FluentScriptHub")
        InterfaceManager:BuildInterfaceSection(Tabs.Settings)
    end
end)

pcall(function()
    if SaveManager and typeof(SaveManager.SetLibrary) == "function" then
        SaveManager:SetLibrary(Fluent)
        SaveManager:IgnoreThemeSettings()
        SaveManager:SetIgnoreIndexes({})
        SaveManager:SetFolder("FluentScriptHub/FishForSecretAnimals")
        SaveManager:BuildConfigSection(Tabs.Settings)
    end
end)

-- ยืนยันการเลือกแท็บแรกอีกครั้งเมื่อคอมโพเนนต์ทั้งหมดถูกสร้างเสร็จสมบูรณ์
pcall(function()
    Window:SelectTab(1)
end)
polishUI()

-- โหลด Config อัตโนมัติเฉพาะของ Account นี้ (ตาม UserId)
task.spawn(function()
    loadAccountConfig()
    task.wait(0.1)
    isScriptInitializing = false
    pcall(function()
        Window:SelectTab(1)
    end)
    polishUI()
end)
