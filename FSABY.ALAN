-- ระบบจำลองการคลิก/แท็ปที่รองรับทั้ง PC และ Mobile (รวม Solara, Delta, Codex, Arceus X, Fluxus, Hydrogen)
local function safeClickGui(guiObj)
    if not (guiObj and guiObj:IsA("GuiObject")) then return end
    local center = guiObj.AbsolutePosition + guiObj.AbsoluteSize / 2
    
    pcall(function()
        if typeof(firesignal) == "function" then
            if guiObj:IsA("GuiButton") then
                firesignal(guiObj.Activated)
                firesignal(guiObj.MouseButton1Click)
                firesignal(guiObj.MouseButton1Down)
                firesignal(guiObj.MouseButton1Up)
            end
        end
    end)
    
    pcall(function()
        if VirtualInputManager and typeof(VirtualInputManager.SendMouseButtonEvent) == "function" then
            VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
            task.wait(0.03)
            VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1)
        end
    end)
    
    pcall(function()
        if VirtualUser then
            VirtualUser:Button1Down(Vector2.new(center.X, center.Y))
            task.wait(0.03)
            VirtualUser:Button1Up(Vector2.new(center.X, center.Y))
        end
    end)
end

