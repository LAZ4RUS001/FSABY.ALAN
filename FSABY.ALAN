local function getSafeGuiParent()
    if typeof(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui and hui:IsA("Instance") then
            return hui
        end
    end
    local lp = game:GetService("Players").LocalPlayer
    local pg = lp and (lp:FindFirstChildOfClass("PlayerGui") or lp:WaitForChild("PlayerGui", 5))
    if pg then return pg end
    local ok, cg = pcall(game.GetService, game, "CoreGui")
    if ok and cg then
        local canAccess = pcall(function() return cg:GetChildren() end)
        if canAccess then return cg end
    end
    return lp:WaitForChild("PlayerGui")
end

-- ลบและทำความสะอาด GUI เก่าทั้งหมดที่ตกค้างในระบบ ป้องกันหน้าต่างซ้อนทับหรือบัคโปร่งใส
local targetRoots = {}
if typeof(gethui) == "function" then
    pcall(function() table.insert(targetRoots, gethui()) end)
end
pcall(function()
    local pg = game:GetService("Players").LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pg then table.insert(targetRoots, pg) end
end)
pcall(function()
    local cg = game:GetService("CoreGui")
    local ok = pcall(function() return cg:GetChildren() end)
    if ok then table.insert(targetRoots, cg) end
end)

for _, root in ipairs(targetRoots) do
    if root then
        pcall(function()
            for _, gui in ipairs(root:GetDescendants()) do
                if gui:IsA("ScreenGui") and (gui.Name == "ScreenGui" or gui.Name == "Fluent" or gui.Name == "SpinachMobileToggle") then
                    for _, desc in ipairs(gui:GetDescendants()) do
                        if desc:IsA("TextLabel") and (desc.Text == "Fish for Secret Animals" or desc.Text:find("by spinach") or desc.Text == "🐟") then
                            pcall(function() gui:Destroy() end)
                            break
                        end
                    end
                end
            end
        end)
    end
end

-- 2. โหลด Fluent UI Library รองรับ Multi-Source Fallback (PC, Delta, Fluxus, Hydrogen, Codex, Arceus X, Solara)
local function safeHttpGet(url)
    local ok, res = pcall(game.HttpGet, game, url, true)
    if ok and res and #res > 500 then return res end
    ok, res = pcall(game.HttpGet, game, url)
    if ok and res and #res > 500 then return res end
    return nil
end

local function safeLoadstring(source)
    if not source then return nil end
    local ok, fn = pcall(loadstring, source)
    if ok and typeof(fn) == "function" then
        local runOk, res = pcall(fn)
        if runOk then return res end
    end
    return nil
end

