-- ฟังก์ชันแปลงและคำนวณตัวเลขพร้อมตัวย่อสกุลเงิน (k, m, b, t, qa, qi, sx, sp, oc, no, dc, ฯลฯ)
local SuffixMultipliers = {
    k = 1e3,
    m = 1e6,
    b = 1e9,
    t = 1e12,
    qa = 1e15,
    q = 1e15,
    qi = 1e18,
    sx = 1e21,
    sp = 1e24,
    oc = 1e27,
    no = 1e30,
    dc = 1e33,
    ud = 1e36,
    dd = 1e39,
    td = 1e42,
    qad = 1e45,
    qid = 1e48,
    sxd = 1e51,
    spd = 1e54,
    ocd = 1e57,
    nod = 1e60,
    vg = 1e63
}

local function parseCurrencyNumber(input)
    if typeof(input) == "number" then return input end
    if typeof(input) ~= "string" then return nil end
    local clean = input:gsub("[%s,$,%%/s]", ""):lower()
    if clean == "" then return nil end
    local direct = tonumber(clean)
    if direct then return direct end
    local numPart, suffixPart = clean:match("^([%d%.]+)%s*([a-z]+)$")
    if numPart and suffixPart then
        local num = tonumber(numPart)
        local mult = SuffixMultipliers[suffixPart]
        if num and mult then
            return num * mult
        end
    end
    return nil
end

local function formatCurrencyNumber(n)
    if not n or typeof(n) ~= "number" then return tostring(n or 0) end
    if Format and typeof(Format.short) == "function" then
        return Format.short(n)
    end
    if n >= 1e15 then return string.format("%.1fQa", n / 1e15):gsub("%.0Qa", "Qa")
    elseif n >= 1e12 then return string.format("%.1fT", n / 1e12):gsub("%.0T", "T")
    elseif n >= 1e9 then return string.format("%.1fB", n / 1e9):gsub("%.0B", "B")
    elseif n >= 1e6 then return string.format("%.1fM", n / 1e6):gsub("%.0M", "M")
    elseif n >= 1e3 then return string.format("%.1fk", n / 1e3):gsub("%.0k", "k")
    else return tostring(math.floor(n)) end
end

-- ระบบ Auto Save/Load Configs แยกตาม Account (UserId) พร้อม Fallback ทุก Executor Sandbox
local gameConfigFolder = "FluentScriptHub/FishForSecretAnimals"
local function getConfigFile()
    local canUseFolder = false
    pcall(function()
        if typeof(makefolder) == "function" and typeof(isfolder) == "function" then
            if not isfolder("FluentScriptHub") then pcall(makefolder, "FluentScriptHub") end
            if not isfolder(gameConfigFolder) then pcall(makefolder, gameConfigFolder) end
            canUseFolder = isfolder(gameConfigFolder)
        end
    end)
    if canUseFolder then
        return string.format("%s/Account_%s.json", gameConfigFolder, tostring(LocalPlayer.UserId))
    else
        return string.format("FishForSecretAnimals_%s.json", tostring(LocalPlayer.UserId))
    end
end

local accountConfigFile = getConfigFile()
local isScriptInitializing = true
local isRestoringConfig = false

local function ensureConfigFolders()
    pcall(function()
        if typeof(makefolder) == "function" and typeof(isfolder) == "function" then
            if not isfolder("FluentScriptHub") then
                pcall(makefolder, "FluentScriptHub")
            end
            if not isfolder(gameConfigFolder) then
                pcall(makefolder, gameConfigFolder)
            end
        end
    end)
end

